{
  "name": "nxtwave-ml-prep",
  "version": "1.0.0",
  "private": true,
  "description": "NxtWave AI/ML Interview Preparation (Career Preparation Program): a question hub that sends students to practice on NxtWave Academy.",
  "type": "module",
  "scripts": {
    "questions": "node scripts/questions.mjs",
    "predev": "node scripts/questions.mjs",
    "dev": "vite",
    "prebuild": "node scripts/questions.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "node scripts/questions.mjs && vitest run",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
